{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Todo Desktop",
  "version": "1.0.0",
  "identifier": "com.aitodo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "AI 待办 · 桌面端",
        "width": 960,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
