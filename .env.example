# Gemini AI（可选）
GEMINI_API_KEY=""

# 服务绑定
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# 前端代理
VITE_API_PROXY=http://127.0.0.1:3001
VITE_WEB_PORT=5173

# JWT：生产环境必须设置为 ≥24 位随机串；未设置时会写入 data/jwt-secret
JWT_SECRET=""

# 默认管理员（首次建库时使用；密码不要用 Admin@123456）
ADMIN_EMAIL="admin@aitodo.local"
ADMIN_PASSWORD=""

# CORS 白名单，逗号分隔
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# 仅在反向代理后开启，才会信任 X-Forwarded-For
TRUST_PROXY=0

APP_URL="http://localhost:5173"
